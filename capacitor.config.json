{
  "appId": "ca.cabintree.app",
  "appName": "Cabintree",
  "webDir": "dist",
  "backgroundColor": "#0c0a09",
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "backgroundColor": "#0c0a09"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0c0a09",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d9488"
    }
  }
}
